+    #[test]
+    fn grouped_occurrences_keep_full_trace_in_local_and_parallel_rounds() {
+        let cases = [
+            prepared(&[(&vec![1; 61], 1)], 1),
+            prepared(&[(&vec![1; 4100], 1)], 1),
+            prepared(
+                &[(&(0..2100).flat_map(|_| [1, 2]).collect::<Vec<_>>(), 3)],
+                2,
+            ),
+        ];
+        for input in cases {
+            let baseline = crate::train(
+                input.clone(),
+                TrainOptions {
+                    max_merges: 3,
+                    min_frequency: 1,
+                    bounds: Bounds::Checked,
+                },
+            )
+            .unwrap();
+            for bounds in [Bounds::Checked, Bounds::Unchecked] {
+                for mode in ["occurrence_grouped", "occurrence_grouped_adaptive"] {
+                    let result = train(
+                        input.clone(),
+                        Options {
+                            max_merges: 3,
+                            min_frequency: 1,
+                            bounds,
+                            workers: 4,
+                        },
+                        mode,
+                    )
+                    .unwrap();
+                    assert_eq!(result.core.merges, baseline.merges, "{mode}");
+                    assert_eq!(result.core.final_tokens, baseline.final_tokens, "{mode}");
+                    assert_eq!(result.core.actual_merges, baseline.actual_merges, "{mode}");
+                    assert_eq!(
+                        result.core.position_visits, baseline.position_visits,
+                        "{mode}"
+                    );
+                    assert_eq!(result.core.stale_visits, baseline.stale_visits, "{mode}");
+                    assert_eq!(result.metrics["grouped_occurrences"], 1.0);
+                    assert!(
+                        result.metrics["global_occurrence_entry_calls"]
+                            <= result.metrics["new_occurrence_positions"]
+                    );
+                    assert_eq!(
+                        result.metrics["actualbarriers"],
+                        2.0 * result.metrics["parallel_rounds"]
+                    );
+                }
+            }
+        }
+    }
 }
