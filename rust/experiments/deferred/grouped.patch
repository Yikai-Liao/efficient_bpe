+        } else {
+            Self::Flat(Vec::new())
+        }
+    }
+
+    #[inline]
+    fn push<const GROUPED: bool>(&mut self, pair: u64, pos: u32) {
+        if GROUPED {
+            let Self::Grouped(grouped) = self else {
+                unreachable!("grouped occurrence output has flat storage")
+            };
+            grouped.entry(pair).or_default().push(pos);
+        } else {
+            let Self::Flat(flat) = self else {
+                unreachable!("flat occurrence output has grouped storage")
+            };
+            flat.push((pair, pos));
+        }
+    }
+}
